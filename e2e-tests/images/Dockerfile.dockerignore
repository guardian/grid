# BuildKit uses this file (named <Dockerfile>.dockerignore) to trim the build
# context for images/Dockerfile. Keeps build artefacts and caches out of the
# context sent to the daemon.
**/target
**/node_modules
**/logs
**/.git
.git
**/.DS_Store
dev/.localstack
# The corporate CA is supplied separately as a BuildKit secret.
.devcontainer/.host-certs
