{
  "name": "kupua",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Modern frontend for Grid — the Guardian's image DAM",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:special-sort-es": "vitest run --config vitest.special-sort-es.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:full": "./scripts/run-e2e.sh",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:tiers": "npx playwright test --config playwright.tiers.config.ts",
    "test:smoke": "node scripts/run-smoke.mjs",
    "test:perf": "node e2e-perf/run-audit.mjs",
    "test:perf-harness": "node --test e2e-perf/harness-validation.test.mjs e2e-perf/p14-metrics.test.mjs",
    "test:perf:pp2": "playwright test --config=e2e-perf/playwright.perceived-short.config.ts --grep=PP2: --reporter=list",
    "test:perf:pp3": "playwright test --config=e2e-perf/playwright.perceived-short.config.ts --grep=PP3: --reporter=list",
    "test:perf:pp4": "playwright test --config=e2e-perf/playwright.perceived-short.config.ts --grep=PP4: --reporter=list",
    "test:perf:pp5": "playwright test --config=e2e-perf/playwright.perceived-short.config.ts --grep=PP5: --reporter=list",
    "test:perf:pp6": "playwright test --config=e2e-perf/playwright.perceived-short.config.ts --grep=PP6: --reporter=list",
    "test:perf:pp6b": "playwright test --config=e2e-perf/playwright.perceived-short.config.ts --grep=PP6b: --reporter=list",
    "test:perf:pp6c": "playwright test --config=e2e-perf/playwright.perceived-short.config.ts --grep=PP6c: --reporter=list",
    "test:perf:pp7": "playwright test --config=e2e-perf/playwright.perceived-short.config.ts --grep='PP7:' --reporter=list",
    "test:perf:pp7b": "playwright test --config=e2e-perf/playwright.perceived-short.config.ts --grep=PP7b: --reporter=list",
    "test:perf:pp7c": "playwright test --config=e2e-perf/playwright.perceived-short.config.ts --grep=PP7c: --reporter=list",
    "test:perf:pp8": "playwright test --config=e2e-perf/playwright.perceived-short.config.ts --grep=PP8: --reporter=list",
    "test:perf:ja": "playwright test --config=e2e-perf/playwright.perceived-long.config.ts --grep='JA:' --reporter=list",
    "test:perf:jb": "playwright test --config=e2e-perf/playwright.perceived-long.config.ts --grep='JB:' --reporter=list",
    "test:experiment": "npx playwright test --config playwright.experiments.config.ts",
    "test:diag": "npx playwright test --config=playwright.debug.config.ts --headed"
  },
  "dependencies": {
    "@guardian/cql": "^1.8.6",
    "@tanstack/react-router": "^1.168.10",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.23",
    "@tanstack/router-zod-adapter": "^1.81.5",
    "date-fns": "^4.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1027.0",
    "@aws-sdk/client-s3": "^3.1027.0",
    "@aws-sdk/credential-providers": "^3.1027.0",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.5.2",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.1",
    "fast-check": "^4.8.0",
    "jsdom": "^29.0.2",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.8.3",
    "vite": "^8.0.8",
    "vitest": "^4.1.4"
  }
}
