{
  "name": "kupua",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Modern frontend for Grid — the Guardian's image DAM",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:justified": "VITE_JUSTIFIED_PREVIEW=true vite --port 3040",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:special-sort-es": "vitest run --config vitest.special-sort-es.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:full": "./scripts/run-e2e.sh",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:ui": "playwright test --ui",
    "pretest:perf": "npm run typecheck:perf",
    "test:perf": "node e2e-perf/run-audit.mjs",
    "test:perf-harness": "node --test e2e-perf/validation/harness-validation.test.mjs e2e-perf/validation/p14-metrics.test.mjs e2e-perf/validation/network-probe.test.mjs e2e-perf/validation/network-reporting.test.mjs e2e-perf/validation/density-reporting.test.mjs e2e-perf/validation/thumbnail-probe.test.mjs e2e-perf/validation/fixed-grid-probes.test.mjs e2e-perf/validation/focused-sort-degradation.test.mjs",
    "typecheck:perf": "tsc --noEmit --project e2e-perf/tsconfig.json",
    "test:perf-fixtures": "playwright test --config=e2e-perf/playwright.density-fixtures.config.ts",
    "test:perf-app": "playwright test --config=e2e-perf/playwright.density-app.config.ts",
    "test:perf:pp2": "playwright test --config=e2e-perf/playwright.perceived-short.config.ts --grep=PP2:",
    "test:perf:pp3": "playwright test --config=e2e-perf/playwright.perceived-short.config.ts --grep=PP3:",
    "test:perf:pp4": "playwright test --config=e2e-perf/playwright.perceived-short.config.ts --grep=PP4:",
    "test:perf:pp5": "playwright test --config=e2e-perf/playwright.perceived-short.config.ts --grep=PP5:",
    "test:perf:pp6": "playwright test --config=e2e-perf/playwright.perceived-short.config.ts --grep=PP6:",
    "test:perf:pp6b": "playwright test --config=e2e-perf/playwright.perceived-short.config.ts --grep=PP6b:",
    "test:perf:pp6c": "playwright test --config=e2e-perf/playwright.perceived-short.config.ts --grep=PP6c:",
    "test:perf:pp7": "playwright test --config=e2e-perf/playwright.perceived-short.config.ts --grep='PP7:'",
    "test:perf:pp7b": "playwright test --config=e2e-perf/playwright.perceived-short.config.ts --grep=PP7b:",
    "test:perf:pp7c": "playwright test --config=e2e-perf/playwright.perceived-short.config.ts --grep=PP7c:",
    "test:perf:pp8": "playwright test --config=e2e-perf/playwright.perceived-short.config.ts --grep=PP8:",
    "test:perf:ja": "playwright test --config=e2e-perf/playwright.perceived-long.config.ts --grep='JA:'",
    "test:perf:jb": "playwright test --config=e2e-perf/playwright.perceived-long.config.ts --grep='JB:'",
    "test:experiment": "npx playwright test --config playwright.experiments.config.ts",
    "test:diag": "npx playwright test --config=playwright.debug.config.ts --headed",
    "review:api-boundary": "node exploration/experiments/api-boundary/api-boundary-review.mjs",
    "test:api-boundary": "node --test exploration/experiments/api-boundary/api-boundary-review.test.mjs",
    "test:es-transport": "node exploration/experiments/es-transport/run.mjs",
    "test:perf-research": "playwright test --config=e2e-perf/research/playwright.config.ts"
  },
  "dependencies": {
    "@guardian/cql": "^1.8.6",
    "@immich/justified-layout-wasm": "0.4.5",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.13",
    "@tanstack/router-zod-adapter": "^1.81.5",
    "date-fns": "^4.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1146.0",
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/credential-providers": "^3.1146.0",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^25.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fast-check": "^4.10.2",
    "jsdom": "^29.0.2",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.8.3",
    "vite": "^8.3.2",
    "vitest": "^4.1.11"
  }
}
