# Settings for the hosted build Kahuna serves (npm run build:hosted).
# This directory is the build's only env source; laptop .env/.env.local are not read.
# Service addresses are injected at runtime by Kahuna, not set here.
VITE_HOSTED=true
VITE_USE_MEDIA_API=true
VITE_MEDIA_DELIVERY=canonical
VITE_MAX_RESULT_WINDOW=100000
VITE_DEEP_SEEK_THRESHOLD=10000
