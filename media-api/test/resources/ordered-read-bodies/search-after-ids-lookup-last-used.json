[
  {
    "path": "/images/search-after",
    "body": {
      "q": "-is:deleted -usages@status:replaced",
      "orderBy": "-usagesDateAdded",
      "sort": [
        {
          "usages.dateAdded": {
            "order": "desc",
            "mode": "max",
            "nested": {
              "path": "usages"
            },
            "missing": "_last"
          }
        },
        {
          "uploadTime": "desc"
        },
        {
          "id": "asc"
        }
      ],
      "until": "2030-01-01T00:00:00.000Z",
      "ids": "fixture-id",
      "length": 1,
      "reverse": false,
      "seekToEnd": false,
      "countAll": false
    }
  }
]
