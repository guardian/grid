      "fields": [
        {
          "field": "metadata.credit",
          "size": 10
        },
        {
          "field": "usageRights.category",
          "size": 10
        },
        {
          "field": "usagesPlatform",
          "size": 20
        },
        {
          "field": "usagesStatus",
          "size": 20
        }
      ],
      "isFilters": [
        "deleted",
        "under-quota"
      ]
    }
  }
]
