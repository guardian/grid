{
  "remoteEnv": {
    "PATH": "/home/vscode/.local/share/mise/shims:/home/vscode/.local/bin:${containerEnv:PATH}"
  },
  "customizations": {
    "vscode": {
      "settings": {
        "cucumber.features": ["e2e-tests/features/**/*.feature"],
        "cucumber.glue": ["e2e-tests/steps/**/*.ts"]
      }
    }
  },
  "image": null,
  "initializeCommand": [
    "/bin/bash",
    "${localWorkspaceFolder}/.devcontainer/prepare-host-ca.sh",
    "${localEnv:DEVCONTAINER_CA_NAME:Cisco Umbrella Root CA}"
  ],
  "build": {
    "dockerfile": "../Dockerfile",
    "context": ".."
  }
}
